# Relay server — copy to .env for local relay, or set as platform secrets

# Listen (Railway/Fly set PORT automatically; override with PAIRRELAY_RELAY_PORT)
# PAIRRELAY_RELAY_PORT=8787
# PAIRRELAY_RELAY_HOST=0.0.0.0

# Public URL for join links (auto-detected on Fly/Railway if unset)
# PAIRRELAY_RELAY_PUBLIC_URL=https://your-relay.example.com

# Required for cloud deploy — do not use the local dev default
PAIRRELAY_RELAY_API_KEYS=your-team-key
PAIRRELAY_RELAY_SECRET=generate-a-long-random-secret

# Phase 2A persistence (optional locally; required for restart survival on Fly)
# Postgres is the durable source of truth; Redis is the hot session cache.
# DATABASE_URL=postgres://pairrelay@localhost:5432/pairrelay
# REDIS_URL=redis://127.0.0.1:6379
# Aliases also accepted:
# PAIRRELAY_DATABASE_URL=
# PAIRRELAY_REDIS_URL=

# Optional GitHub OAuth (redirect uses PAIRRELAY_RELAY_PUBLIC_URL)
# PAIRRELAY_GITHUB_CLIENT_ID=
# PAIRRELAY_GITHUB_CLIENT_SECRET=
